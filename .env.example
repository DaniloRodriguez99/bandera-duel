# Development defaults also work from a phone on 192.168.x.x / 10.x.x Wi-Fi.
PORT=2567
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bandera-duel-dfwe.vercel.app
# Set to the public Render URL (wss://...) before building for Vercel.
# VITE_SERVER_URL=ws://localhost:2567
# Development only: simulate 150 ms round-trip latency.
# COLYSEUS_LATENCY=150
# Where accounts and characters are saved. Unset = in memory: everything is lost on restart
# (fine for development; the server warns about it when NODE_ENV=production).
# STORE_FILE points at one JSON file on a local, persistent disk (a VPS, your machine):
# STORE_FILE=./data/personajes.json
# Cloud Run and Render's free plan have NO persistent disk, so a STORE_FILE there is wiped on every
# deploy or restart. Production needs the Postgres driver on DATABASE_URL, which is not built yet:
# setting DATABASE_URL today makes the server refuse to start instead of silently using memory.
# DATABASE_URL=postgres://user:password@host:5432/bandera
