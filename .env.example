# Development defaults also work from a phone on 192.168.x.x / 10.x.x Wi-Fi.
PORT=2567
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bandera-duel-dfwe.vercel.app
# Set to the public Render URL (wss://...) before building for Vercel.
# VITE_SERVER_URL=ws://localhost:2567
# Development only: simulate 150 ms round-trip latency.
# COLYSEUS_LATENCY=150
# Where accounts and characters are saved, in this order:
# DATABASE_URL = Postgres. What production should use: Cloud Run turns the server off when nobody
# plays and has no disk, so only a database keeps characters between starts. Neon's free plan works
# (it also sleeps when unused). Tables are created on first use.
# DATABASE_URL=postgres://user:password@host/bandera?sslmode=require
# STORE_FILE = one JSON file on a local, persistent disk (a VPS, your machine).
# STORE_FILE=./data/personajes.json
# Neither = in memory: everything is lost on restart (the server warns in production).
# Tests: point TEST_DATABASE_URL at a throwaway database to run the store contract against Postgres.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bandera_test
