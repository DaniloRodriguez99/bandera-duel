{
  "name": "@bandera/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./world": {
      "types": "./dist/world.d.ts",
      "default": "./dist/world.js"
    },
    "./rpg/*": {
      "types": "./dist/rpg/*.d.ts",
      "default": "./dist/rpg/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
